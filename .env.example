# =============================================================================
# Variables for Docker Compose. Copy to .env and fill in your values.
# An API run outside Docker reads apps/api/.env instead.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://jobsense:jobsense@localhost:5432/jobsense
REDIS_URL=redis://localhost:6379/0

# ─── Auth / Security ─────────────────────────────────────────────────────────
# Replace with the output of: openssl rand -hex 32
# The API refuses to start with this placeholder unless ENVIRONMENT is
# development or test.
SECRET_KEY=your-super-secret-key-change-this-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ─── AI / LLM Providers ──────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=openai         # openai | anthropic

# ─── Apify ───────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=

# ─── Google OAuth + APIs ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ─── AWS / S3-Compatible Storage ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=jobsense-assets

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development             # development | staging | production
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
