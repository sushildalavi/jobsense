# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://jobsense:jobsense@localhost:5432/jobsense
# Async variant is derived automatically; set explicitly to override
# ASYNC_DATABASE_URL=postgresql+asyncpg://jobsense:jobsense@localhost:5432/jobsense

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth / Security ─────────────────────────────────────────────────────────
# Replace with the output of: openssl rand -hex 32
# The API refuses to start with this placeholder unless ENVIRONMENT is
# development or test.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ─── AI Providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=openai         # openai | anthropic

# ─── Apify ───────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=

# ─── Google OAuth / Gmail / Calendar ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ─── AWS / S3 ────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=jobsense-documents

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development             # development | staging | production
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
